# ==============================================================================
# CheckNow Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in your local root directory:
#    cp .env.example .env
# 2. Fill in the required credentials and configuration values below.
# 3. NEVER commit your local '.env' file or production secrets to Git!
# ==============================================================================

# Application Environment Mode (development | staging | production)
APP_ENV=development

# Application General Settings
APP_NAME=CheckNow
APP_VERSION=1.0.0
APP_LOCALE=vi_VN

# Firebase Project Configuration (from Firebase Console -> Project Settings)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=AIzaSy_YOUR_API_KEY_HERE
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Notification Configuration
NOTIFICATION_CHANNEL_ID=importance_channel
NOTIFICATION_CHANNEL_NAME="Task Reminder Channel"

# Local SQLite Database Name
SQLITE_DB_NAME=task1.db
SQLITE_DB_VERSION=1
